{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "compress": true,
    "showLineNumbers": true,
    "removeComments": false,
    "removeEmptyLines": false
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/*,cover",
      "**/*.pyc",
      "**/__pycache__/**",
      "backend/.venv/**",
      "backend/dummy/**",
      "backend/audiovault.db",
      "htmlcov/**",
      ".coverage*",
      "frontend/coverage/**",
      "**/*.lock",
      "**/*.tsbuildinfo",
      ".semgrepignore",
      ".trivyignore",
      "backend/verify_api.py"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}

DATABASE_URL=postgresql://postgres:postgres@db:5432/audiovault
REDIS_URL=redis://redis:6379/0

# Admin Setup (Required for first run)
FIRST_SUPERUSER="admin@example.com"
FIRST_SUPERUSER_PASSWORD="admin" # Change this!

# Security
JWT_SECRET_KEY=change_this_to_a_secure_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# External Services
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
# Note: Spotify blocks 'localhost' as of 2025. Use 'http://127.0.0.1:3000' for local dev.
# For production, HTTPS is required.

YOUTUBE_API_KEY=

# Storage
DOWNLOAD_DIR=/downloads
MAX_PARALLEL_DOWNLOADS=3
STORAGE_QUOTA_GB=500
LOG_LEVEL=INFO

# Networking
ALLOWED_HOSTS=*
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

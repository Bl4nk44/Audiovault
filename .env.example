DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audiovault
REDIS_URL=redis://localhost:6379/0

# Security (Change these in production!)
JWT_SECRET_KEY=change_me_to_a_secure_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FIRST_SUPERUSER_PASSWORD=admin

# Integration Keys
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/callback

YOUTUBE_API_KEY=your_youtube_api_key

# App Configuration
DOWNLOAD_DIR=/downloads
MAX_PARALLEL_DOWNLOADS=3
STORAGE_QUOTA_GB=500
LOG_LEVEL=INFO

# Reverse Proxy & Docker Configuration
# ALLOWED_HOSTS=audiovault.example.com,localhost
# BACKEND_CORS_ORIGINS=https://audiovault.example.com

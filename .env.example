DATABASE_URL=postgresql://user:password@localhost:5432/audiovault
REDIS_URL=redis://localhost:6379/0

# Admin Setup (Required for first run)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changethispassword" # Change this!

# Security
JWT_SECRET_KEY=changeme # Generate using: openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# External Services

# Spotify Integration (all optional — app uses embedded fallback credentials)
# SPOTIFY_CLIENT_ID=your_spotify_client_id       # Override embedded spotDL credentials
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# SPOTIFY_SP_DC=your_sp_dc_cookie_value          # Free account cookie, ~1yr TTL; get from DevTools → Application → Cookies
# SPOTIFY_HOST_PROXY=http://host.docker.internal:8765  # Run spotify-host-proxy.py on WSL2 host for embed scraping

# Route all provider media traffic (yt-dlp downloads + URL resolution) through a proxy.
# Supported: http://, https://, socks4://, socks5://, socks5h:// (auth: user:pass@host:port)
# Everything else (API, metadata lookups, Subsonic streaming) connects directly.
# DOWNLOAD_PROXY=http://privoxy:8118

# Last.fm Integration
LASTFM_API_KEY=your_lastfm_api_key
LASTFM_API_SECRET=your_lastfm_api_secret

# ListenBrainz Integration (optional) — no API key; users paste a personal
# token from https://listenbrainz.org/settings/. Override only for self-hosted.
# LISTENBRAINZ_API_URL=https://api.listenbrainz.org

# Lyrics (Genius)
GENIUS_API_TOKEN=your_genius_api_token_here

# Registration
# Master kill-switch for new account sign-ups. Set to false to force-disable
# registration regardless of the in-app admin toggle. Default: true.
REGISTRATION_ENABLED=true

# Storage
DOWNLOAD_DIR=/downloads
MAX_PARALLEL_DOWNLOADS=3
STORAGE_QUOTA_GB=500
LOG_LEVEL=INFO
TIMEZONE=UTC

# Networking
ALLOWED_HOSTS=*
BACKEND_CORS_ORIGINS=["http://localhost:2137", "http://localhost:3000", "http://localhost:5173"]

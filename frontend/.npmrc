# NPM registry configuration for improved reliability
registry=https://registry.npmjs.org/

# Increase timeout for npm operations
fetch-timeout=120000

# Enable offline mode fallback
prefer-offline=true

# Disable audit to speed up installation
audit=false

# Use exact versions from package-lock.json
ignore-scripts=false

# ESLint 10 peer dependency workaround
legacy-peer-deps=true

# Supply chain: wait 7 days before resolving newly published package versions (npm >= 11.10)
min-release-age=7

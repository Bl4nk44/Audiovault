FROM node:24-alpine

WORKDIR /app

# Copy root version file if needed (optional context, but sticking to pattern)
COPY VERSION /VERSION

# Copy root package.json for potential shared config (optional)
COPY package*.json ./

# Copy frontend dependencies
COPY frontend/package*.json ./
RUN npm ci

# Copy source code
COPY frontend/ .

# Give the runtime user ownership so the Vite dev server (USER node) can write
# its dependency-optimize cache (node_modules/.vite). The named node_modules
# volume inherits this ownership on first creation; without it Vite fails with
# EACCES on mkdir and the dev app never loads.
RUN chown -R node:node /app

# Expose port
EXPOSE 5173

# Switch to non-root user
USER node

# Health check — Vite dev server
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -q --spider http://localhost:5173/ || exit 1

# Command for Dev
CMD ["npm", "run", "dev", "--", "--host"]
